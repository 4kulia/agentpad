<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Developer ID build (scripts/release.sh). Notarization
  requires the hardened runtime, and under it macOS refuses a protected
  resource outright unless the app holds the matching entitlement — the
  usage-description keys in Info.plist are then not enough.

  A terminal is the "responsible process" for everything started in its
  tabs, so the list mirrors the usage descriptions build-app.sh declares for
  those programs. Apple events are also used by AgentPad itself, to bring a
  session's Terminal or iTerm2 tab to the front.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
</dict>
</plist>
