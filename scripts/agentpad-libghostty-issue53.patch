+test "allocation failure mid-update recovers on the next update" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var t = try Terminal.init(io, alloc, .{
+        .cols = 20,
+        .rows = 5,
+    });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+
+    // Content with styled runs and a multi-codepoint grapheme so a
+    // full build exercises every allocation class: row data, cell
+    // buffers, pending style runs, and per-row arena (managed memory).
+    s.nextSlice("\x1b[1mBold\x1b[0m plain\r\n字👨‍👩‍👧\r\nrow2\r\nrow3");
+
+    // For every allocation point within an update, inject a failure at
+    // exactly that point, then verify that the next update with a
+    // healthy allocator fully recovers: `incomplete` must force a full
+    // rebuild that matches a fresh state, even though the failed
+    // attempt already consumed terminal dirty flags for the rows it
+    // visited. Each attempt starts from a brand-new empty state so
+    // that retained capacities from a prior recovery can't absorb
+    // allocations and skip failure points.
+    var fail_index: usize = 0;
+    const completed = while (fail_index < 1000) : (fail_index += 1) {
+        var state: RenderState = .empty;
+        defer state.deinit(alloc);
+
+        var failing = std.testing.FailingAllocator.init(alloc, .{
+            .fail_index = fail_index,
+        });
+        if (state.beginUpdate(failing.allocator(), &t)) |_| {
+            // No failure was injected: a full build performs fewer
+            // allocations than this fail_index, so every allocation
+            // point has been covered by the prior iterations.
+            state.endUpdate();
+            break true;
+        } else |err| try testing.expectEqual(error.OutOfMemory, err);
+
+        // Recover with a healthy allocator: this update must succeed
+        // and produce a state identical to a fresh full rebuild.
+        try state.update(alloc, &t);
+
+        var fresh: RenderState = .empty;
+        defer fresh.deinit(alloc);
+        try fresh.update(alloc, &t);
+        try testCompareStates(&state, &fresh);
+    } else false;
+    try testing.expect(completed);
+}
+
+test "incomplete state forces a full rebuild on the next update" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var t = try Terminal.init(io, alloc, .{
+        .cols = 10,
+        .rows = 3,
+    });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    s.nextSlice("row0\r\nrow1\r\nrow2");
+
+    var state: RenderState = .empty;
+    defer state.deinit(alloc);
+    try state.update(alloc, &t);
+
+    // Simulate what an interrupted update leaves behind (the renderer
+    // SIGSEGV class: an empty row cell buffer the cursor may point
+    // at): destroy one row's cell buffer with no terminal-side dirty
+    // flag left that would trigger its rebuild.
+    {
+        const cells = state.row_data.slice().items(.cells);
+        try testing.expect(cells[1].len > 0);
+        cells[1].deinit(alloc);
+        cells[1] = .empty;
+    }
+    state.incomplete = true;
+
+    // The terminal is completely clean, so without the incomplete flag
+    // this update would skip every row and leave row 1 unbuilt.
+    try state.update(alloc, &t);
+
+    const cells = state.row_data.slice().items(.cells);
+    try testing.expectEqual(@as(usize, 10), cells[1].len);
+
+    var fresh: RenderState = .empty;
+    defer fresh.deinit(alloc);
+    try fresh.update(alloc, &t);
+    try testCompareStates(&state, &fresh);
+}
